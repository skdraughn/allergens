  "findings": [
    {
      "findingId": "sol-confirmed-abaf1c423892a77e",
      "material": true,
      "firstDiscoveredStage": "sol",
      "stageFindingIds": {
        "luna": [],
        "terra": [],
        "sol": [
          "Affected baseline: 25 of 88 items—Aushak Appetizer, Bourani Banjan Appetizer, Fried Tilapia Appetizer, Hummus, Mantu Appetizer, Karak Chai, Baklava, Firnee, Goshe Feel \"Elephant Ears\", Aushak Entrée, Mantu Entrée, Vegetarian Aushak Entree, Vegetarian Salad, Chaplee Beef Kabob, Eggplant, Naan, Salmon Kabob, Yogurt, five naan-wrapped sandwiches, Aush, and Mashawa. Reconciliation reports 88 reconciled and 88 unique baseline items, no duplicate reconciled keys, and all 88 classified as normalized_match/mismatch."
        ]
      },
      "expectedGateIds": [],
      "resolution": "Accepted by the Sol-medium coordinator review."
    },
    {
      "findingId": "sol-confirmed-b5e9a90795a7bbd9",
      "material": true,
      "firstDiscoveredStage": "sol",
      "stageFindingIds": {
        "luna": [],
        "terra": [],
        "sol": [
          "The official menu is an enumerable current catalog, but its descriptions are not a comprehensive ingredient or allergen guide. It cannot support allergen negatives, complete arrays, may-contain conclusions, or cross-contact conclusions."
        ]
      },
      "expectedGateIds": [],
      "resolution": "Accepted by the Sol-medium coordinator review."
    },
    {
      "findingId": "sol-confirmed-f7347ee4b60bc28c",
      "material": true,
      "firstDiscoveredStage": "sol",
      "stageFindingIds": {
        "luna": [],
        "terra": [],
        "sol": [
          "Narrow restaurant-issued positives remain valid where explicit: fish for tilapia and salmon; egg for Chaplee Beef Kabob; sesame from tahini in Hummus; tree nut from pistachio in Baklava, Firnee, and Goshe Feel; and milk where yogurt, milk, or sweet cream is expressly named."
        ]
      },
      "expectedGateIds": [],
      "resolution": "Accepted by the Sol-medium coordinator review."
    },
    {
      "findingId": "sol-confirmed-237bd408875550ce",
      "material": true,
      "firstDiscoveredStage": "sol",
      "stageFindingIds": {
        "luna": [],
        "terra": [],
        "sol": [
          "Firnee exposes a concrete baseline discrepancy: the baseline lists only tree nut, while the current restaurant description expressly identifies both milk and pistachio."
        ]
      },
      "expectedGateIds": [],
      "resolution": "Accepted by the Sol-medium coordinator review."
    },
    {
